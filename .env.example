# Demo Portal API Configuration
# Required for accessing the Continia Demo Portal API
DEMO_PORTAL_TOKEN=your-api-token-here

# Optional: Override default API URL
# DEMO_PORTAL_BASE_URL=https://demoportaldev.continiaonline.com/api/v1.0

# Optional: Developer endpoint tenant (default: "default")
# DEV_TENANT=default

# Optional: Allow self-signed certificates for local development (default: false)
# ALLOW_INSECURE_CERTS=false

# Optional: Enable interactive prompts for VS Code extension (default: false for MCP)
# INTERACTIVE_PROMPTS=false

# Optional: Default authentication method (default: NavUserPassword)
# DEFAULT_AUTH_METHOD=NavUserPassword

# Optional: Logging configuration
# LOG_LEVEL=info
# LOG_FORMAT=json

# Test Environment (for integration tests)
# CTN_TEST_ENVIRONMENT_ID=your-test-environment-id

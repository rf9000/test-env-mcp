{
  "name": "continia-environment-mcp",
  "version": "0.2.1",
  "description": "MCP server for managing Continia Business Central environments and executing automated tests",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "continia-environment-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "node esbuild.config.js",
    "build:tsc": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "precommit": "npm run typecheck && npm run lint",
    "test": "vitest",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "dev": "tsc --watch",
    "prepare": "husky"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "business-central",
    "continia",
    "testing",
    "environment-management"
  ],
  "author": "Continia",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.7",
    "csv-parse": "^5.6.0",
    "fast-xml-parser": "^4.5.0",
    "form-data": "^4.0.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/node": "^22.8.4",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "@vitest/coverage-v8": "^2.1.3",
    "esbuild": "^0.27.0",
    "eslint": "^9.13.0",
    "husky": "^9.1.6",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
